root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{c,h}]
indent_style = space
indent_size = 4

[*.{cs,csproj,props,targets,sln}]
indent_style = space
indent_size = 4

[*.{cmake,md,yml,yaml,json}]
indent_style = space
indent_size = 2

[CMakeLists.txt]
indent_style = space
indent_size = 4

[Makefile]
indent_style = tab
